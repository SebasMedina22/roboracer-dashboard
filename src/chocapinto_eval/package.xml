<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>chocapinto_eval</name>
  <version>0.1.0</version>
  <description>Automatic evaluation of simulation runs (simulation only): laps, lap times, cone contacts, clearance, stuck detection and odometry drift against Gazebo's true pose.</description>
  <maintainer email="sebastianmedina063@gmail.com">Sebas</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- from the course stack (isselab/rrstack), built in ~/rrstack/ros_ws -->
  <exec_depend>roboracer_gazebo</exec_depend>
  <exec_depend>roboracer_planning</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-scipy</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
